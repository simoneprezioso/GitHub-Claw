# GitHub personal access token (classic or fine-grained, public repo read is enough).
# Without this, the app falls back to unauthenticated GitHub API requests, which
# are rate-limited to 60 requests/hour per IP — fine for trying it out, but you'll
# hit limits fast. Create one at https://github.com/settings/tokens (no scopes
# needed for public repo search).
GITHUB_TOKEN=

# Optional: enable the embedding-based reranker on top of the heuristic ranker.
# Off by default — the deterministic path is the floor. When set to "1", the
# top 20 heuristic candidates get re-scored with cosine similarity from
# Xenova/all-MiniLM-L6-v2 (transformers.js, runs locally, no API key).
# First call after server start downloads the ~25MB model (cached after that).
# ENABLE_EMBEDDING_RERANK=1
