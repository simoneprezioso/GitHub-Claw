# GitHub personal access token (classic or fine-grained, public repo read is enough).
# Without this, the app falls back to unauthenticated GitHub API requests, which
# are rate-limited to 60 requests/hour per IP — fine for trying it out, but you'll
# hit limits fast. Create one at https://github.com/settings/tokens (no scopes
# needed for public repo search).
GITHUB_TOKEN=

# The embedding-based semantic reranker is ON by default — the top heuristic
# candidates are re-scored with cosine similarity from Xenova/all-MiniLM-L6-v2
# (transformers.js, runs locally, no API key). The deterministic heuristic stays
# the floor and is used automatically if the model can't load. The first search
# after boot downloads the ~25MB model (then it's disk-cached).
# Turn it OFF with:
# DISABLE_EMBEDDING_RERANK=1

# Optional: point at a bundled copy of the embedding model to skip the ~25MB
# download on cold starts (recommended for serverless / Docker images).
# TRANSFORMERS_MODEL_PATH=./models
